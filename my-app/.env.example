# Configuración para el Chatbot con Gemini AI
# IMPORTANTE: Nunca subas este archivo con valores reales a GitHub

# API Key de Google Gemini (obtener en: https://makersuite.google.com/app/apikey)
# Debe empezar con "AIza"
REACT_APP_GEMINI_API_KEY=tu_api_key_aqui

# NOTAS DE SEGURIDAD:
# 1. Las variables REACT_APP_* son públicas en el build de React
# 2. Para mayor seguridad en producción, considera usar un backend proxy
# 3. Implementa rate limiting en el servidor si es necesario
# 4. Monitorea el uso de la API para detectar abuso

# Configuración de desarrollo (opcional)
REACT_APP_ENV=development

# Formulario: BuildShip permanece como valor predeterminado/productivo.
# Solo configurar google en Cloudflare Pages PREVIEW durante QA aprobado.
REACT_APP_CONTACT_PROVIDER=buildship
# REACT_APP_TURNSTILE_SITE_KEY=clave_publica_de_turnstile
# CONTACT_SHARED_SECRET / CONTACT_APPS_SCRIPT_URL / TURNSTILE_SECRET_KEY
# son secretos de Pages Functions y nunca deben usar prefijo REACT_APP_.
